# Copy to .env for local dev. On GitHub Actions / Render, set these as
# Secrets / Environment Variables instead — never commit a real .env file.
# WARNING: this repo is public. Never put a real key or connection string
# directly in code, workflow YAML, or anything that gets committed.

# --- Postgres (Supabase) ---
# Use the SESSION POOLER connection string (Supabase dashboard -> Connect
# button -> "Session pooler"), NOT "Direct connection" — the direct
# connection is IPv6-only and fails with "Network is unreachable" from
# GitHub Actions and many other hosts (confirmed 2026-07-13).
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Price data providers (src/providers/) ---
# Both are built into the backend. ingestion_config.active_provider in
# Postgres picks which is tried first — yfinance needs no key and is the
# seeded default, so TIINGO_API_KEY is only required if you switch
# active_provider to 'tiingo' (or want automatic fallback to work when
# yfinance gets throttled).
TIINGO_API_KEY=your-tiingo-key-here
FRED_API_KEY=your-fred-key-here

# --- Fundamentals data provider: SEC EDGAR (src/providers/sec_edgar_provider.py) ---
# Swapped from FMP 2026-07-13 — FMP's free tier turned out to plan-gate
# ratios, key-metrics, AND income-statement (confirmed via live 402s on
# every S&P 500 ticker tested). EDGAR is completely free, no plan tiers,
# ever — but requires a descriptive User-Agent identifying who's making
# requests (SEC's fair-access policy, not optional — requests without one
# commonly get a 403). Format: "YourName/YourApp your-email@example.com"
SEC_EDGAR_USER_AGENT=aitmai quant-fund-system your-email@example.com

# --- FMP (kept for reference/potential future use — NOT used by
# fundamentals ingestion anymore, see above) ---
FMP_API_KEY=your-fmp-key-here

# --- Options data (deferred — only needed once hedge-sleeve backtesting is turned on) ---
EODHD_OPTIONS_API_KEY=

# --- Universe construction (src/universe/index_sources.py) ---
# S&P 500: sourced from Wikipedia's constituents table (free, no key,
# no bot-detection issues). Also the source of `universe.cik`, needed for
# SEC EDGAR fundamentals lookups. Override only if Wikipedia's page
# structure changes and parsing breaks.
SP500_WIKIPEDIA_URL=
# Russell 1000: iShares IWB holdings CSV — kept as best-effort only.
# The equivalent S&P 500 (IVV) endpoint turned out to be blocked by
# iShares' bot detection even with browser-like headers, so expect this
# to likely return nothing too. Manual ticker upload is the practical
# path for going beyond S&P 500 right now. (Also note: manually-added
# tickers have no CIK unless you supply one, so EDGAR fundamentals won't
# be available for them automatically.)
IWB_HOLDINGS_CSV_URL=

# --- Ingestion throttles (DESIGN.md §5) ---
# NOTE: the authoritative daily budgets live in the ingestion_config table
# (migrations/001 seeds price=400; migrations/003 sets fundamentals=5000
# since EDGAR has no daily cap, only a 10 req/sec rate limit — see below).
# These env vars are read by price_ingestion.py / fundamentals_ingestion.py
# only for the backfill lookback window, staleness thresholds, and pacing
# below — they do not override ingestion_config.
PRICE_BACKFILL_YEARS=3
FUNDAMENTALS_STALENESS_DAYS=80

# Delay between successive yfinance requests. Yahoo throttles bursts of
# rapid requests (surfaces as "Expecting value: line 1 column 1 (char 0)"
# for otherwise perfectly valid, currently-listed tickers) — this is NOT
# the same as a bad/delisted ticker. Raise this if you still see frequent
# throttling-looking failures even with pacing on.
PRICE_REQUEST_DELAY_SECONDS=0.5
# Hard timeout per yfinance request. Without this, a single stalled
# connection to Yahoo can hang indefinitely, stalling the whole daily run
# behind one bad ticker. A timeout here is treated as retryable — the
# fallback provider (Tiingo) gets tried next, and it'll succeed or fail
# fast on its own 30s timeout (see tiingo_provider.py).
PRICE_REQUEST_TIMEOUT_SECONDS=15
# If this many tickers in a row ALL fail (both providers exhausted), that's
# broad provider throttling for this session, not a run of coincidentally
# bad tickers — every remaining ticker is essentially guaranteed to fail
# too. The run stops early rather than grinding through it; those tickers
# retry automatically on the next scheduled run.
PRICE_MAX_CONSECUTIVE_FAILURES=15

# EDGAR's real limit is 10 req/sec SEC-wide (not per-key). This default
# stays comfortably under that with margin — an IP-level SEC block would
# be a much bigger problem than a slightly slower ingestion run.
FUNDAMENTALS_REQUEST_DELAY_SECONDS=0.2
# Same protective early-stop as price ingestion, kept as a safety net
# in case EDGAR itself has an outage or starts rate-limiting broadly.
FUNDAMENTALS_MAX_CONSECUTIVE_FAILURES=15

# --- Hedge sleeve sizing (Phase 9, DESIGN.md §3) ---
# Real portfolio NAV comes from fund_metadata/portfolio_snapshots, which
# don't exist until Phase 7 (Trade Tracking & Positions) is built. Until
# then, this stands in for NAV so the hedge sleeve's target dollar
# allocation (10% of NAV, per the dual-sleeve split) is a real number
# rather than a fabricated one baked into code. Replace with a real
# fund size, or leave the 1000000 default for sizing dry-runs.
HEDGE_SLEEVE_NAV_PLACEHOLDER=1000000
